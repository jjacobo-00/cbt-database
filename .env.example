# ============================================================
# CBT Church Member Directory — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Database (Neon Serverless Postgres) ---
DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/dbname?sslmode=require

# --- NextAuth v5 ---
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=your-strong-random-secret-here

# --- Google OAuth Provider ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email: Resend API (Primary) ---
# Sign up at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email: Gmail SMTP (Fallback) ---
# Use an App Password, NOT your regular Gmail password.
# Enable 2FA then generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Session Secret (used by lib/session.ts for OTP JWTs) ---
# Should match or be derived from AUTH_SECRET
SESSION_SECRET=your-strong-random-session-secret-here

# --- Supabase (Legacy — kept for reference, no longer used in app) ---
# NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
